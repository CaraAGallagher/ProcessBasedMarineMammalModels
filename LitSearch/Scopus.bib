@ARTICLE{Fiechter2016273,
author={Fiechter, J. and Huckstadt, L.A. and Rose, K.A. and Costa, D.P.},
title={A fully coupled ecosystem model to predict the foraging ecology of apex predators in the California Current},
journal={Marine Ecology Progress Series},
