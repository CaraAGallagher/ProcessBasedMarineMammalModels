@article{ WOS:000337855000003,
Author = {Ku, Kuo-Cheng and Chen, Tsen-Chien and Ying, Ta-Chung},
Title = {A collaborative reference model for monitoring whale-watching quantity
   in the Hualien coastal area, Taiwan},
Journal = {OCEAN \& COASTAL MANAGEMENT},
Year = {2014},
Volume = {95},
Pages = {26-34},
Month = {JUL},
Abstract = {The whale-watching activities have recently increased with rising
   tourism business in the Hualien coastal area in Taiwan. In the past,
   lack of adequate systems for controlling the quantity of overloaded
   whale-watching tourists and communicating with whale-watching businesses
   has led to serious impact on whale and dolphin ecology. In order to
   reduce the impact on whale and dolphin ecology and other ocean
   creatures, this study presents a process-based reference model and
   information system for helping the East Coast National Scenic Area
   Administration to better manage and control whale-watching quantity. The
   tool set of IDEF (Integration Definition) is applied to describe the
   overall workflow of whale-watching processes. An object-oriented
   analysis approach is used to represent the architecture of the
   collaborative model. In this research, we suggest the East Coast
   National Scenic Area Administration can conduct and establish the model
   and welcome all stockholders to discuss proper whale-watching processes
   together on proposed platform. (C) 2014 Elsevier Ltd. All rights
   reserved.},
