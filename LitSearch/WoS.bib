@article{ WOS:000289400300002,
Author = {Sun, Xiaofeng and Yin, Yong and Jin, Yicheng and Zhang, Xinyu and Zhang,
   Xiufeng},
Title = {The modeling of single-boat, mid-water trawl systems for fishing
   simulation},
