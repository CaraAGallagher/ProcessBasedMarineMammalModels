Address = {24-28 OVAL RD, LONDON NW1 7DX, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Van Verdeghem, J (Corresponding Author), UCL, Inst Mech Mat \& Civil Engn IMMC, Ctr Res Mech CEREM, B-1348 Louvain La Neuve, Belgium.
   Van Verdeghem, J.; Kluyskens, V.; Dehez, B., UCL, Inst Mech Mat \& Civil Engn IMMC, Ctr Res Mech CEREM, B-1348 Louvain La Neuve, Belgium.},
DOI = {10.1016/j.jsv.2017.05.042},
ISSN = {0022-460X},
EISSN = {1095-8568},
Keywords = {Electrodynamic; Thrust; Bearing; Dynamic model; State-space
   representation; Linear},
