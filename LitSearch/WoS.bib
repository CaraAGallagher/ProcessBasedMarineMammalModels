@article{ WOS:000385616900001,
Author = {Liu Chunbao and Li Li and Lei Yulong and Liu Changsuo and Zhang Yubo},
Title = {Drag Reduction and Performance Improvement of Hydraulic Torque
   Converters with Multiple Biological Characteristics},
Journal = {APPLIED BIONICS AND BIOMECHANICS},
Year = {2016},
Volume = {2016},
Abstract = {Fish-like, dolphin-like, and bionic nonsmooth surfaces were employed in
   a hydraulic torque converter to achieve drag reduction and performance
   improvement, which were aimed at reducing profile loss, impacting loss
   and friction loss, respectively. YJSW335, a twin turbine torque
   converter, was bionically designed delicately. The biological
   characteristics consisted of fish-like blades in all four wheels,
   dolphin-like structure in the first turbine and the stator, and
   nonsmooth surfaces in the pump. The prediction performance of bionic
   YJSW335, obtained by computational fluid dynamics simulation, was
   improved compared with that of the original model, and then it could be
   proved that drag reduction had been achieved. The mechanism accounting
   for drag reduction of three factors was also investigated. After bionic
   design, the torque ratio and the highest efficiencies of YJSW335 were
   both advanced, which were very difficult to achieve through traditional
   design method. Moreover, the highest efficiency of the low speed area
   and high speed area is 85.65\% and 86.32\%, respectively. By economic
   matching analysis of the original and bionic powertrains, the latter can
   significantly reduce the fuel consumption and improve the operating
   economy of the loader.},
