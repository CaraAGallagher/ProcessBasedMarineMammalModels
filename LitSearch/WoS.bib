@article{ WOS:000077218600011,
Author = {Heleno, P and dos Santos, MP},
Title = {Artificial animals in virtual ecosystems},
Journal = {COMPUTER NETWORKS AND ISDN SYSTEMS},
Year = {1998},
Volume = {30},
Number = {20-21},
Pages = {1923-1932},
Month = {NOV 12},
Abstract = {This paper presents an architecture to support the simulation and
   visualization of virtual ecosystems in a virtual reality system. The
   ecosystems are inhabited by artificial animals. Each animal in the
   ecosystem is an agent that interacts autonomously with the dynamic
   environment and the other animals. A small part of the ecosystem in the
   estuary of river Sado was simulated. Mullets, dolphins and jellyfishes
   were modeled according to the purposed architecture and the simulation
   runs on top of a virtual reality library that provides a real-time
   visualization. The possibility of a networking solution with multiple
   remote users controlling some of the animals and thus using the virtual
   ecosystems as shared virtual worlds is also mentioned in this paper.
   Some screenshots are presented along with the text to illustrate the
   graphical aspects of the simulated objects. (C) 1998 Elsevier Science
   B.V. All rights reserved.},
