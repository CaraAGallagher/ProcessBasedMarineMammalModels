@ARTICLE{Weber2009,
author={Weber, P.W. and Murray, M.M. and Howle, L.E. and Fish, F.E.},
title={Comparison of real and idealized cetacean flippers},
journal={Bioinspiration and Biomimetics},
year={2009},
