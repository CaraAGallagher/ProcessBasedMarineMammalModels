affiliation={Key Laboratory of Underwater Acoustic Communication and Marine Information Technology, Ministry of Education, Xiamen University, Xiamen, 361005, China; College of Ocean and Earth Sciences, Xiamen University, Xiamen, 361005, China; State Key Laboratory of Acoustics, Institute of Acoustics, Chinese Academy of Sciences, Beijing, 100190, China; Hawaii Institute of Marine Biology, University of Hawaii, 46-007 Lilipuna Road, Kaneohe, HI  96744, United States; Third Institute of Oceanography, State Oceanic Administration, Xiamen, Fujian, 361005, China},
abstract={Through numerically solving the appropriate wave equations, propagation of biosonar signals in a Chinese river dolphin (baiji) was studied. The interfacial waves along the rostrum-tissue interfaces, including both compressional (longitudinal) and shear (transverse) waves in the solid rostrum through fluid-solid coupling were examined. The baiji's rostrum was found to effect acoustic beam formation not only as an interfacial wave generator but also as a sound reflector. The wave propagation patterns in the solid rostrum were found to significantly change the wave movement through the bone. Vibrations in the rostrum, expressed in solid displacement, initially increased but eventually decreased from posterior to anterior sides, indicating a complex physical process. Furthermore, the comparisons among seven cases, including the combination of (1) the rostrum, melon, and air sacs; (2) rostrum-air sacs; (3) rostrum-melon; (4) only rostrum; (5) air sacs-melon; (6) only air sacs; and (7) only melon revealed that the cases including the rostrum were better able to approach the complete system by inducing rostrum-tissue interfacial waves and reducing the differences in main beam angle and -3 dB beam width. The interfacial waves in the rostrum were considered complementary with reflection to determine the obbligato role of the rostrum in the baiji's biosonar emission. The far-field beams formed from complete fluid-solid models and non-fluid-solid models were compared to reveal the effects brought by the consideration of shear waves of the solid structures of the baiji. The results may provide useful information for further understanding the role of the rostrum in this odontocete species. © 2016 American Physical Society.},
document_type={Article},
source={Scopus},
}

@CONFERENCE{Weissenberger2016,
author={Weissenberger, J. and Dushane, J. and Vos, D. and Ede, E.},
title={Traditional ecological knowledge on acoustic disturbance-research project partnering with communities on the North Slope, Alaska},
journal={Society of Petroleum Engineers - SPE International Conference and Exhibition on Health, Safety, Security, Environment, and Social Responsibility},
year={2016},
doi={10.2118/179284-ms},
note={cited By 0},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85088352411&doi=10.2118%2f179284-ms&partnerID=40&md5=1fd76796455c1214d25f961cb4964424},
affiliation={Statoil, Norway; Alaska Ecological Research, United States},
abstract={Underwater noise from Exploration and Production industry (E&P) has the potential to impact marine organisms in the ocean by inducing behavioral reactions. Even if effects on the population of marine mammals might be negligible, an impact of the ability of local communities to hunt for marine mammals has the potential to effect traditional ways of life. The aim of this study was to gather local information on behavioral reactions of marine mammals to be utilized for risk assessment of E&P activities. Behavioral reactions of marine mammals to sound disturbance (such as those from EP activities) are complex and are only partially studied and understood through western science methodology. Through thousands of years of subsistence hunting of marine mammals, Native Alaskans have developed extensive local and traditional knowledge (LTK) of marine mammal behavior in a variety of contexts. As there is no known written body of LTK on behavioral reactions of marine mammals to sound, we partnered with the Native governments of three villages on the Chukchi Sea coast, to document this knowledge, utilizing semi-directed interviews, and community advisors. Seventy interviews were conducted, recorded with video, audio recording or written notes and statements were systematically analyzed using transcripts. Reports were quality checked by community advisors, which were individuals from these communities who had been selected by the tribal government. Video documentation form the interviews where compiled and given back to the respective community to be used for their purposes and to archive. Behavioral reactions to sound stimuli were grouped for species, type of reaction, distance and duration of direction and sound properties that triggered the reaction. Avoidance behavioral response included diving, changing direction, increasing swimming speed, leaving the ice, hiding under the ice, surfacing less or more frequently, attacking the source of the sound and attraction behaviors such as swimming or surfacing closer to the sound. Sound types that were observed to be especially disturbing to some marine mammals were abrupt, staccato sounds or otherwise transient sounds such as knocking or banging noises. Qualitative information from LTK was used to create a set of rules for E&P activities. A more quantitative analysis was done by feeding the LTK learnings into a behavioral model simulating the movement of marine mammals based on habitat characteristics called Agent Based Modelling (ABM) (Nestler et al 2005). One of the primary goals of this research was to begin the process of understanding the experiences of Native Alaskans and other local knowledge holders regarding how marine mammals have responded to sound and other stimulus. The first step towards this goal was to listen to and document these experiences. This has been successfully achieved and first steps of including this knowledge in modeling tools have been done allowing for a place specific risk assessment. Copyright 2016, Society of Petroleum Engineers.},
document_type={Conference Paper},
source={Scopus},
}

