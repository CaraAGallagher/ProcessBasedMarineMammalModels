@ARTICLE{Fernandez20172816,
author={Fernandez, M. and Yesson, C. and Gannier, A. and Miller, P.I. and Azevedo, J.M.N.},
title={The importance of temporal resolution for niche modelling in dynamic marine environments},
journal={Journal of Biogeography},
year={2017},
