title={Analysis and simulation of an extended data set of waveforms received from small explosions in shallow oceans},
journal={1st Australasian Acoustical Societies' Conference 2006, ACOUSTICS 2006: Noise of Progress},
year={2006},
pages={485-492},
note={cited By 10},
