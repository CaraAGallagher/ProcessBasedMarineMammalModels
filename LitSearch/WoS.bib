   N Carolina State Univ, Dept Stat, Biomath Program, Raleigh, NC 27695 USA.
   James Cook Univ N Queensland, Townsville, Qld 4811, Australia.
   CRC, Reef Res Ctr, Townsville, Qld 4811, Australia.},
DOI = {10.2193/0022-541X(2006)70{[}255:EAAIHE]2.0.CO;2},
ISSN = {0022-541X},
EISSN = {1937-2817},
