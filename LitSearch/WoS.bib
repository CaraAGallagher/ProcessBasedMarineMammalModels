@article{ WOS:000256630500008,
Author = {Monni, Stefano and Li, Hongzhe},
Title = {Vertex clustering in random graphs via reversihle jump Markov chain
   Monte Carlo},
Journal = {JOURNAL OF COMPUTATIONAL AND GRAPHICAL STATISTICS},
Year = {2008},
Volume = {17},
Number = {2},
Pages = {388-409},
Month = {JUN},
Abstract = {Networks are a natural and effective tool to study relational data, in
   which observations are collected on pairs of units. The units are
   represented by nodes and their relations by edges. In biology, for
   example, proteins and their interactions may be the nodes and the edges
   of the network; in social science, the nodes and edges may be people and
   interpersonal relations. In this article we address the question of
   clustering vertices in networks as a way to uncover homogeneity patterns
   in data that enjoy a network representation. We use a mixture model for
   random graphs and propose a reversible jump Markov chain Monte Carlo
   algorithm to infer its parameters. Applications of the algorithm to one
   simulated dataset and three real datasets, which describe friendships
   among members of a university karate club, social interactions of
   dolphins, and gap junctions in the C. Elegans, are given.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
Type = {Article},
Language = {English},
Affiliation = {Li, Hongzhe, Univ Penn, Dept Biostat \& Epidemiol, Philadelphia, PA 19104 USA.},
DOI = {10.1198/106186008X321941},
ISSN = {1061-8600},
EISSN = {1537-2715},
Keywords = {Bayesian model selection; modules; networks; Wang Landau},
Keywords-Plus = {MODEL; COMMUNITY},
Research-Areas = {Mathematics},
Web-of-Science-Categories  = {Statistics \& Probability},
Author-Email = {smonni@mail.med.upenn.edu},
