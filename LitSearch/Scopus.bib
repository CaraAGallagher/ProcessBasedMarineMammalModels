}

@ARTICLE{Diebold2010,
author={Diebold, J.B. and Tolstoy, M. and Doermann, L. and Nooner, S.L. and Webb, S.C. and Crone, T.J.},
title={R/V Marcus G. Langseth seismic source: Modeling and calibration},
journal={Geochemistry, Geophysics, Geosystems},
