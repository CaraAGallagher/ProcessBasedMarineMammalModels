@article{ WOS:000263307700006,
Author = {Von Loebbecke, Alfred and Mittal, Rajat and Mark, Russell and Hahn,
   James},
Title = {A computational method for analysis of underwater dolphin kick
   hydrodynamics in human swimming},
Journal = {SPORTS BIOMECHANICS},
Year = {2009},
Volume = {8},
Number = {1},
Pages = {60-77},
Abstract = {We present a new method that combines the use of laser body scans,
   underwater video footage, software-based animation, and a fully unsteady
   computational fluid dynamics technique to simulate and examine the
   hydrodynamics of the dolphin kick. The focus of the current work is to
   model this particular stroke in all its complexity with minimal ad-hoc
   assumptions or simplifications. Simulations of one female and one male
   swimmer (both at about 1.7m beneath the water surface) at velocities of
   0.95 and 1.31m/s and Strouhal numbers of 1.21 and 1.06 respectively are
   presented. Vorticity and fluid velocity profiles in the wake are
   examined in detail for both swimmers. A three-dimensional vortex ring is
   clearly identified in the wake for one of the cases and a
   two-dimensional slice through the ring corroborates previous experiments
   of Miwa et al. (2006). We also find that most of the thrust is produced
   by the feet and in both cases the down-kick produces much larger thrust
   than the up-kick.},
