@ARTICLE{Tang20241328,
	author = {Tang, Jun and Li, Jiayong and Sun, Xinmiao},
	title = {Drag reduction study on the biomimetic adaptive deformation of the wall surface of underwater vehicles; 水下航行器壁面仿生自适应变形的减阻研究},
