@ARTICLE{Blazejewski2015,
author={Blazejewski, T. and Nursimulu, N. and Pszenny, V. and Dangoudoubiyam, S. and Namasivayam, S. and Chiasson, M.A. and Chessman, K. and Tonkin, M. and Swapna, L.S. and Hung, S.S. and Bridgers, J. and Ricklefs, S.M. and Boulanger, M.J. and Dubey, J.P. and Porcella, S.F. and Kissinger, J.C. and Howe, D.K. and Grigg, M.E. and Parkinsona, J.},
title={Systems-based analysis of the sarcocystis neurona genome identifies pathways that contribute to a heteroxenous life cycle},
journal={mBio},
year={2015},
