@article{ WOS:A1995QT32800004,
Author = {EBERHARDT, LL},
Title = {USING THE LOTKA-LESLIE MODEL FOR SEA OTTERS},
Journal = {JOURNAL OF WILDLIFE MANAGEMENT},
Year = {1995},
Volume = {59},
Number = {2},
Pages = {222-227},
Month = {APR},
Abstract = {Using the Lotka-Leslie model to assess population trend of sea otters
   (Enhydra lutris) is complicated by the fact that pups can be born in any
   month of the year.  I used a Monte Carlo simulation model to devise an
   adjustment for this reproductive pattern.  Choices of mean birth dates
   used in the model were tested by simulating population growth to
   determine lambda directly, for comparison with estimates of lambda from
   reproductive and survival rate data recorded in simulations.  I used
   bootstrapping to obtain confidence limits on an estimate of lambda from
   the California sea otter population and compared results with variance
   estimated by the delta method.  The 2 approaches gave essentially the
   same result, but the delta method also can be used to determine sample
   sizes needed to obtain a given coefficient of variation on lambda.},
