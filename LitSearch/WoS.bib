@article{ WOS:000308330000011,
Author = {Freymann, Douglas M. and Nakamura, Yuka and Focia, Pamela J. and Sakai,
   Ryuichi and Swanson, Geoffrey T.},
Title = {Structure of a tetrameric galectin from Cinachyrella sp (ball sponge)},
Journal = {ACTA CRYSTALLOGRAPHICA SECTION D-STRUCTURAL BIOLOGY},
Year = {2012},
Volume = {68},
Number = {9},
Pages = {1163-1174},
Month = {SEP},
Abstract = {The galectins are a family of proteins that bind with highest affinity
   to N-acetyllactosamine disaccharides, which are common constituents of
   asparagine-linked complex glycans. They play important and diverse
   physiological roles, particularly in the immune system, and are thought
   to be critical metastatic agents for many types of cancer cells,
   including gliomas. A recent bioactivity-based screen of marine sponge
   (Cinachyrella sp.) extract identified an ancestral member of the
   galectin family based on its unexpected ability to positively modulate
   mammalian ionotropic glutamate receptor function. To gain insight into
   the mechanistic basis of this activity, the 2.1 angstrom resolution
   X-ray structure of one member of the family, galectin CchG-1, is
   reported. While the protomer exhibited structural similarity to
   mammalian prototype galectin, CchG-1 adopts a novel tetrameric
   arrangement in which a rigid toroidal-shaped `donut' is stabilized in
   part by the packing of pairs of vicinal disulfide bonds. Twofold
   symmetry between binding-site pairs provides a basis for a model for
   interaction with ionotropic glutamate receptors.},
Publisher = {INT UNION CRYSTALLOGRAPHY},
Address = {2 ABBEY SQ, CHESTER, CH1 2HU, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Freymann, DM (Corresponding Author), Northwestern Univ, Feinberg Sch Med, 303 E Chicago Ave, Chicago, IL 60611 USA.
   Freymann, Douglas M.; Focia, Pamela J.; Swanson, Geoffrey T., Northwestern Univ, Feinberg Sch Med, Chicago, IL 60611 USA.
   Nakamura, Yuka; Sakai, Ryuichi, Hokkaido Univ, Fac Fisheries Sci, Hakodate, Hokkaido 0418611, Japan.},
DOI = {10.1107/S0907444912022834},
ISSN = {2059-7983},
