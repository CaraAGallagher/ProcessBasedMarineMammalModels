Address = {1801 ALEXANDER BELL DR, RESTON, VA 20191-4400 USA},
Type = {Article},
Language = {English},
Affiliation = {Decker, J (Corresponding Author), USGS, Florida Water Sci Ctr, 7500 SW 36th St, Davie, FL 33314 USA.
