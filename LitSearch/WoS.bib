Language = {English},
Affiliation = {Fetherston, T (Corresponding Author), Naval Undersea Warfare Ctr, 1176 Howell St, Newport, RI 02841 USA.
   Fetherston, Thomas; Turner, Stephen; Mitchell, Glenn; Guzas, Emily, Naval Undersea Warfare Ctr, 1176 Howell St, Newport, RI 02841 USA.},
DOI = {10.1002/ar.24033},
ISSN = {1932-8486},
EISSN = {1932-8494},
Keywords = {marine mammal; underwater explosion; DYSMAS; modeling; lung dynamics},
Keywords-Plus = {MORPHOLOGY},
