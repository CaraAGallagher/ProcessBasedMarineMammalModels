@ARTICLE{Nabe-Nielsen2014242,
author={Nabe-Nielsen, J. and Sibly, R.M. and Tougaard, J. and Teilmann, J. and Sveegaard, S.},
title={Effects of noise and by-catch on a Danish harbour porpoise population},
journal={Ecological Modelling},
