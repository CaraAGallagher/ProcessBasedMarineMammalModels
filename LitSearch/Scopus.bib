@CONFERENCE{Zamanizadeh2011,
author={Zamanizadeh, E. and Gomes, J. and Bioucas-Dias, J.M.},
title={Source localization from time-differences of arrival using high-frequency communication signals},
journal={OCEANS'11 - MTS/IEEE Kona, Program Book},
