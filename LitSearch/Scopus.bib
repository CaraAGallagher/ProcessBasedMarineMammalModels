@CONFERENCE{GlennFord20051304,
author={Glenn Ford, R. and Bonnell, M.L.},
title={Computer simulation of the effects of oil development on seabird and marine mammal populations},
journal={2005 International Oil Spill Conference, IOSC 2005},
year={2005},
pages={1304-1305},
note={cited By 0},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-33646035774&partnerID=40&md5=1f6cd9ff146746c685e7480f906efaf4},
affiliation={Ecological Consulting, 5333 Gaylord Drive, San Diego, CA 92117, United States; Center for Marine Studies, University of California, Santa Cruz, CA 95064, United States},
abstract={Oil spill risk analysis, based on the simulation of oil spill trajectories using wind and ocean current data, is now a well developed field. While these models arc routinely used to evaluate the potential environmental effects of offshore oil development, translating the results of trajectory models into estimates of potential population changes for animals such as seabirds or marine mammals has been difficult. We address this problem using two computer simulation models which translate the results of trajectory models into either short or long term estimates of changes in population size resulting from oil spill related mortality. The short-term oil response model (STORM) simulates the daily pattern of behavior and geographic distribution of a species. It takes into account factors such as daily activity cycles, movement into and out of foraging areas, concentration of animals around colonies and feeding areas, time spent in areas safe from oil contact, and changes in behavior and geographic distribution which take place at different times of the year. Using output from an oil spill trajectory model such as the Mineral Management Services OSRAM, STORM simulates the passage of an oil slick through the population. The model calculates the number of animals which would come into contact with the slick and estimates the resulting mortality, given what is known about age and sex differences in vulnerability, as well as the tendency of the species to avoid oiling. By repeating this procedure many times, we estimate the probability that a platform site, transportation route, or entire development scenario will result in a given level of mortality for the species in question. Estimates of the long-term effects of oil development are made using the oil spill population response model, OSPREY. This model projects population size and composition from year to year based on age-specific fecundity and mortality. When data are available, it also takes into account density dependence and year to year variation in survivorship and reproduction. Output from the STORM model is used to modify estimates of annual mortality, simulating the effects of oil development. OSPREY is used to estimate the probability that the population size will be reduced as a result of offshore oil-development, and how large that reduction is likely to be. We have applied these risk analysis models to seabird populations of the Pribil of Islands in the Bering Sea, seabird, cetacean, and pinniped populations inhabiting the Southern California Bight, and the California sea otter population within its present range and at potential translocation sites. In this presentation, we illustrate the application of these models using data for the California sea otter and Brown Pelican populations.},
document_type={Conference Paper},
source={Scopus},
}

