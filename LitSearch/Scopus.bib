title={Estimated tissue and blood N 2 levels and risk of decompression sickness in deep-, intermediate-, and shallow-diving toothed whales during exposure to naval sonar},
journal={Frontiers in Physiology},
year={2012},
volume={3 MAY},
doi={10.3389/fphys.2012.00125},
