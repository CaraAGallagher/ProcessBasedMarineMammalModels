@CONFERENCE{Chufamanee2004,
author={Chufamanee, P. and Bhuridej, R.},
title={Hydraulic and ecological effects of saltwater barrier in Songkhla Lake Basin},
journal={Bridging the Gap: Meeting the World's Water and Environmental Resources Challenges - Proceedings of the World Water and Environmental Resources Congress 2001},
year={2004},
volume={111},
doi={10.1061/40569(2001)336},
note={cited By 0},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-75649120422&doi=10.1061%2f40569%282001%29336&partnerID=40&md5=e96e060566b64439870568cb4e6f2202},
affiliation={Office of Environmental Policy and Planning, Natural Resources and Environment Management Division, 60/1 Soi Phibunwattana 7, Rama VI Road, Bangkok 10400, Thailand},
abstract={This paper presents results of a numerical model that assesses environmental impacts arising from a saltwater barrier proposed for construction to solve a water shortage in the northern area of the Songkhla Lake Basin. Songkhla Lake Basin is the largest lake system in Thailand covered an area of 8,020 km2 in the South. Approximately 13.5% of the basin are water area consisted of four interconnected lakes: 1) Thale Sap Songkhla, the most seaward and a marine lake with tidal interchange and fresh water outflow to the Gulf of Thailand in the wet season (salinity is ∼ 23-30 ppt in dry season); 2) Thale Sap, a transitional zone between marine and freshwater systems (salinity variation between 0-20 ppt); 3) Thale Luang, a large open body of mainly fresh water; and (4) Thale Noi, the farthest inland lake surrounded by valuable freshwater swamp ecosystems called Phru Khuan Khreng, Thailand's first Ramsar Wetland. The lakes are relatively shallow with average depths ranging from 1 m in Thale Sap Songkhla to 2.5 m in Thale Luang. Water levels fluctuate in response to seasonal variations in sea level and rainfall. The annual average, minimum, and maximum rainfalls are 1,820 mm, 1,200 mm and 2,200 mm, respectively. There are about 1.5 million populations in the basin. The present (1998) water demand in Songkhla Lake Basin is 1,732 million m3 and is projected to increase to 1,790 million m3 in the year 2015. Major water users include: domestic (3.7%), industrial (2.2%), aquaculture (1.6%), livestock (0.3%), and irrigation (92%). To minimize water shortages in the dry season especially in the upper part of the Songkhla Lake Basin, a 5.8 km long saltwater barrier is proposed between Thale Luang and Thale Sap to prevent saltwater from entering Thale Luang. A quasi two-dimensional, vertically-integrated, surface water model called MIKE 11 has been used to assess the potential hydraulic and ecological effects arising from the proposed barrier. To adapt MIKE 11 to the Songkhla Lake Basin the 4 lakes are divided into a number of interconnected, one-dimensional flow channels. This technique allowed simulation of the large scale, two-dimensional, water circulation patterns in a reasonable running time. Songkhla Lake Basin was divided into 12 sub-catchments. Runoff from each sub-catchment discharged into one of the lakes and was generated by a rainfallrunoff module, calibrated for years 1991 to 1996. Water quality data used in the hydrodynamic model was calibrated for the years 1992 to 1993. Salinity level was estimated from the advection-dispersion module. Model simulations were executed for a number of scenarios, including the proposed barrier and irrigation schemes. The combination of the barrier and a water abstraction of 18 to 22 m3/s (full irrigation scheme) from the created reservoir in Thale Luang, the ecosystems of the Phru Khuan Khreng Swamp, Thale Noi, and Thale Luang will be very severely affected. Water levels will drop 0.7-0.9 m in the dry season, causing the swamps to dry out, turning Thale Noi into a shallow pool, and reducing the water level in Thale Luang by 40 - 50%. Many aquatic species will be lost or severely stressed (e.g., the population of Irrawaddy Dolphins in Thale Luang will likely disappear due to increased temperatures, lack of water and food supply from the lower lakes, reduced habitat, and salinity change). The barrier will also increase the retention time and load of nutrients in the upper lakes. For the maximum water abstraction without constructing the barrier, salinity and flow of nutrients to Thale Luang from Thale Sap Songkhla will increase resulting in ecological damage to this lake and increased eutrophication of this system. Copyright ASCE 2004.},
document_type={Conference Paper},
source={Scopus},
}

