affiliation={Department of Civil Engineering, Auburn UniversityAL  36849-5337, United States},
abstract={The Perdido and Wolf Bay system in Alabama and Florida, USA, is an estuarine system linking the freshwater from the Perdido and Wolf Bay watersheds and the tidal saltwater from the Gulf of Mexico through Perdido Pass, Dolphin Pass, and the Gulf Intracoastal Waterway. A three-dimensional hydrodynamic model using environmental fluid dynamics code (EFDC) was developed and used to analyze complex and dynamic flow, salinity, and temperature distributions in the system. The external driving forces for the model include the river discharges from natural and urban watersheds, atmospheric winds, and astronomical tidal elevations at the open boundaries where flow exchange takes place. Simulated water surface elevation, temperature, and salinity were compared against the field data at several observation stations in 2008 and 2009 with good agreement. The calibrated EFDC model was then used to evaluate the age of water under different river inflow conditions. The concept of age was applied to understand the pollutant transport in the overall system. The dynamic and complex interactions between tides from Gulf of Mexico and inflows from streams were revealed by age of water. Age of water was less than 20 days and 70 days for water released from all the major rivers in the Wolf Bay and Perdido watershed during two-year return flow conditions and mean inflows. Flow and salt exchange between the Gulf of Mexico and the Perdido-Wolf system was also examined using the calibrated model. Freshwater and saltwater exchange takes place in a daily time scale at all three open boundaries (Perdido Pass, Dolphin Pass, and Gulf Intracoastal Waterway). In this study, the Eulerian decomposition method was used to calculate the salt flux and flow exchange between Wolf Bay and Perdido Bay. The salt exchange calculation allows us to understand the salt gain and salt loss into the system through different boundaries. It was found that Dolphin Pass, and Perdido Pass were the boundaries where most of the salt exchange took place. © 2014 American Society of Civil Engineers.},
document_type={Conference Paper},
source={Scopus},
}

@ARTICLE{Huang2014147,
