@article{ WOS:000648525500042,
Author = {Xia, Dan and Yin, Qifeng and Li, Zhihan and Chen, Weishan and Shi, Yunde
   and Dou, Jianping},
Title = {Numerical study on the hydrodynamics of porpoising behavior in dolphins},
Journal = {OCEAN ENGINEERING},
Year = {2021},
Volume = {229},
Month = {JUN 1},
Abstract = {This paper employs numerical simulation to study the hydrodynamics of
   porpoising behavior in dolphins. The virtual swimmer is a
   three-dimensional dolphin-like body with prescribed kinematics. A
   four-stage model of this behavior is proposed, including underwater
   acceleration, upward leap, air glide and downward dive. When the dolphin
   goes through these four stages, the time history of its displacement,
   velocity, force and energy could be solved to elucidate the rules. By
   varying oscillating frequency f and escape angle alpha, various
   behaviors of the swimmer are simulated to obtain their porpoising
   performance, which are evaluated by maximum leap height H-max, maximum
   leap distance D-max and leap efficiency eta. The results show that both
   H-max and D-max are increasing functions of f, but their trend with
   alpha is not monotonic. For peak H-max generation, alpha occurs at 90
   degrees, while for peak D-max, alpha is ranging from 45 degrees to 60
   degrees and nears 50 degrees. As for efficiency, eta increases slowly
   with the increase of alpha, and first increases and then decreases with
   the increase of f at a critical value between 7 Hz and 8 Hz. The
   findings may provide an important hydrodynamics basis for the biomimetic
   vehicle designs that mimic the porpoising motion of dolphins.},
