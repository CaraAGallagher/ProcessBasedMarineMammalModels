   USDA ARS, Beltsville Agr Res Ctr, Beltsville Agr Res Ctr E, Anim \& Nat Resources Inst,Anim Parasit Dis Lab, Beltsville, MD 20705 USA.},
DOI = {10.1016/j.meegid.2006.01.001},
ISSN = {1567-1348},
