@article{ WOS:000294752700022,
Author = {Sawant, Ramesh L. and Wadekar, Jyoti B. and Lanke, Prashant D.},
Title = {QSAR Analysis of Structurally Similar Antitubercular Isatin Analogues},
Journal = {LATIN AMERICAN JOURNAL OF PHARMACY},
Year = {2011},
Volume = {30},
Number = {4},
Pages = {773-780},
Month = {MAY},
Abstract = {A series of structurally similar isatin analogues with antitubercular
   activity have been subjected for 2D and 3D QSAR analysis using V life
   MDS 3.5 software. The compounds were divided into training and test set
   of 44 and 11 each. Best QSAR models were selected on the basis of
   various statistical parameters like square correlation coefficient
   (r(2)), cross validated square correlation coefficient (q(2)), standard
   error of estimation (SE) and sequential Fischer test (F). QSAR studies
   reveals that new isatin analogues with less bulky substitution on
   nitrogen of first position and at third position electropositive side
   chain of optimum four atoms length whose terminal atom is substituted
   with aromatic system bearing polar group may be better antitubercular
   agents.},
