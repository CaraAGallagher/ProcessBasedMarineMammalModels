@article{ WOS:001559163100001,
Author = {Araoye, Timothy Oluwaseun and Egoigwe, Sochima Vincent and Mbunwe,
   Muncho Josephine and Ezeama, Osita Anthony},
Title = {Walrus optimizer algorithm for techno-economic modeling of an autonomous
   hybrid microgrid energy management system},
Journal = {ENERGY CONVERSION AND MANAGEMENT},
Year = {2025},
Volume = {344},
Month = {NOV 15},
Abstract = {This study presents optimal sizing and techno-economic modeling of an
   autonomous microgrid energy management system to achieve sustainable
   demands load in remote regions using PSO, GWO and WO Algorithm. The
   techniques involve detailed analyses of different renewable system
   components sizing, including wind, hydro, diesel, PV, battery, and
   biogas system in the Enugu Ezike community which comprises 33 villages.
   The demand response method was applied to maintain operational
   reliability in microgrid architecture, when power generation drops below
   load demand. The result shows that PV/Wind/Hydro/Biogas configuration
   exhibits the lowest COE of 0.005081\$/kWh and the lowest NPC of \$163731
   with 0\% emission among the six configurations considered under WO, GWO
   and PSO Algorithm. Also, renewable energy sizing suggested by PSO and
   GWO is incredibly high and leads to a significant increase in COE and
   NPC compared to WO-based algorithm. The LPSP values obtained from the
   WO, GWO and PSO indicate that the renewable energy met the LPSP
   criteria, suggesting that the system is reliable. Compared to PSO and
   GWO, the WO obtains the fastest rate of convergence which gives highly
   competitive performance when addressing power problems. The introduction
   of the Walrus Optimizer (WO) Algorithm supports the advancement and
   broader application of artificial intelligence, enhances optimization
   efficiency, and provides robust tools for tackling complex power
   generation.},
DOI = {10.1016/j.enconman.2025.120277},
EarlyAccessDate = {AUG 2025},
Article-Number = {120277},
ISSN = {0196-8904},
EISSN = {1879-2227},
ResearcherID-Numbers = {Mbunwe, Muncho/JKJ-1652-2023},
ORCID-Numbers = {Araoye, Timothy Oluwaseun/0000-0002-8405-465X
   },
Unique-ID = {WOS:001559163100001},
}

@article{ WOS:001545750500001,
Author = {Ramakoteswararao, S. and Palanivel, S. and Murthy, G. L. N.},
Title = {ATUN-MDC image registration: Performance enhancement of medical image
   registration using adaptive TransUNet with multi-dilated convolution
   model},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {111},
Month = {JAN},
Abstract = {In medical sector, the medical image registration is the significant
   approach for managing multiple medical images, volume, and surface in
   the coordinate system. In medical images, discovering a precise match
   between multi-modal images is still difficult because distinct image
   modalities are obtained by various acquisition techniques. Based on
   their different properties, it receives an incorrect registered output.
   To tackle these problems, this research work introduces an adaptive
   deep-learning method for accurate image registration using patient data.
   The proposed work is processed in two phases like image collection and
   image registration. Firstly, the real patient scan image is collected
   from the publically available data resource and then subjected to an
   image registration process. For the image registration process, the new
   model is suggested named as Adaptive Transformer-Unet with Multi-Dilated
   Convolution (ATUN-MDC) for offering superior performance. The adaptation
   of the proposed model is integrated with the Transformer and U-Net model
   along with the multi-dilated convolution layer. This network processes
   the multi-modal image registration that shows precise outcome promptly.
   For further enhancement, the hyper-parameters present in the model are
   tuned by Iteration-based Walrus Optimization Algorithm (IWOA). Finally,
   the proposed model is compared with another conventional model to know
   the efficiency of the result. This result analysis shows the developed
   model offers effective performance when compared with other classical
   methods. Hence, the PSNR achieves a higher value than 6.97\% of DDMReg,
   11.7\% of CNN, and 5.98\% of HCN, respectively. Therefore, the
   simulation analysis helps the designed method offer better performance.},
DOI = {10.1016/j.bspc.2025.108392},
EarlyAccessDate = {AUG 2025},
Article-Number = {108392},
ISSN = {1746-8094},
EISSN = {1746-8108},
ResearcherID-Numbers = {S, Ramakoteswararao/IVH-1366-2023
   Sengottayan, Palanivel/V-9694-2019
   Murthy, Dr.G.L.N./ABG-7136-2021},
ORCID-Numbers = {S, Ramakoteswararao/0009-0003-5073-0837
   },
Unique-ID = {WOS:001545750500001},
}

@article{ WOS:001544898200002,
Author = {Bao, Xingxian and Li, Jianghao and Wu, Wei and Wang, Teng},
Title = {Damage identification of offshore wind turbine blades based on graph
   neural networks and successive variational mode decomposition},
Journal = {OCEAN ENGINEERING},
Year = {2025},
Volume = {340},
Number = {2},
Month = {NOV 30},
Abstract = {The Offshore Wind Turbine Blades (OWTBs) are prone to cracking and even
   fracture accidents due to the influence of harsh environmental
   conditions and complex dynamic loads. Therefore, this paper proposes a
   method of damage location and severity identification for OWTBs.
   Firstly, the hyperparameters of Sequential Variational Mode
   Decomposition (SVMD) were optimized by combining the Walrus Optimization
   Algorithm (WaOA), and the effective Intrinsic Mode Functions (IMFs) were
   adaptively selected through the double-threshold method, thereby
   extracting the main features of the signal. Secondly, the location and
   severity identification of the blade damage were achieved based on Graph
   Sample and Aggregate (GraphSAGE), which is a member of the Graph Neural
   Network (GNN) family. In the numerical simulation, the OWTB model with
   cracks at different positions and lengths under different noise
   conditions were considered. In the experimental study, several crack
   damage cases of the OWTB under random excitation were simulated, and it
   was found that the proposed method achieved an average accuracy of 98.73
   \% in damage identification and a maximum error of 1.5 \% in damage
   severity assessment. The numerical and experimental results show that
   the proposed WaOA-SVMD-GNN method can accurately identify the damage
   location and severity of OWTBs.},
DOI = {10.1016/j.oceaneng.2025.122310},
EarlyAccessDate = {AUG 2025},
Article-Number = {122310},
ISSN = {0029-8018},
EISSN = {1873-5258},
ORCID-Numbers = {Bao, Xingxian/0000-0002-8555-8366},
Unique-ID = {WOS:001544898200002},
}

@article{ WOS:001529793000001,
Author = {Combs-Hintze, Bea and Hostetler, Jeffrey A. and Calleson, Charles S. and
   Bassett, Brandon L. and Ainsworth, Cameron H. and Martin, Julien},
Title = {Using community-reported data to understand how boat speed affects
   marine wildlife: An example with the Florida manatee},
Journal = {ECOLOGICAL SOLUTIONS AND EVIDENCE},
Year = {2025},
Volume = {6},
Number = {3},
Month = {JUL 16},
Abstract = {Boat collisions are a known and increasing threat to many marine
   wildlife populations. The Florida manatee Trichechus manatus latirostris
   is a key example of a species with high boat-related mortality, whose
   long-term viability and population are limited by human activities in
   shared habitats. The goal of this work was to quantify the probability
   of lethal injury to Florida manatees using community-reported data on
   collisions with boats. We test the hypothesis that higher boat speeds
   increase the probability of lethal injury to manatees. Empirical data to
   test this hypothesis are collected opportunistically, with low sample
   sizes and uncertainty in reported boat speed. We fit a logistic
   regression model using Bayesian inference with Markov Chain Monte Carlo
   to community-reported collision data. We also present results for two
   errors-in-variables modelling approaches that account for uncertainty in
   boat speeds reported as qualitative values. The first uses a multiple
   imputation approach, whereas the second uses Bayesian estimation with
   informed priors. We evaluated issues related to quasi-separation, sample
   size, and measurement errors using simulated data. The models predicted
   that the probability of lethal injury increased at greater strike speed.
   However, the small number of records with low boat speed or where the
   injury was considered non-lethal contributed to uncertainty around this
   functional relationship. Although the relationships were consistent
   among models, the uncertainty was greater for the errors-in-variables
   models. Practical implication. When combined with information on manatee
   and boat abundance and behaviour, the results of this analysis can be
   used to predict the number of deadly collisions, test alternative
   management scenarios and inform speed zone regulations. We also identify
   ways to improve data reporting to reduce uncertainty in the effect of
   boat speed on lethal injury to marine wildlife. This type of analysis
   can be applied to any marine animal where records of collisions with
   boats are kept.},
DOI = {10.1002/2688-8319.70058},
Article-Number = {e70058},
EISSN = {2688-8319},
ResearcherID-Numbers = {Bassett, Brandon/LFS-2890-2024
   Ainsworth, Cameron/E-8507-2011
   Hostetler, Jeffrey/A-3345-2011},
ORCID-Numbers = {Martin, Julien/0000-0002-7375-129X
   Hostetler, Jeffrey/0000-0003-3669-1758},
Unique-ID = {WOS:001529793000001},
}

@article{ WOS:001529445800001,
Author = {Jacobs, Ellen and Wei, Chong and Erbe, Christine and Mann, Janet},
Title = {Cultural transmission of animal tool use driven by trade-offs: insights
   from sponge-using dolphins},
Journal = {ROYAL SOCIETY OPEN SCIENCE},
Year = {2025},
Volume = {12},
Number = {7},
Month = {JUL 16},
Abstract = {Although tool use offers obvious benefits to the user, the role of costs
   in the spread of tool use has received scant attention. Sponge tool use
   is a foraging technique restricted to a small subpopulation of
   bottlenose dolphins (Tursiops aduncus) in Shark Bay, Australia, that
   carry basket sponges on their beaks to probe the seafloor and flush out
   camouflaged fish, widening the search area and protecting the beak from
   abrasion. While most instances of animal tool use extend the phenotype,
   we hypothesized that sponges interfere with echolocation, particularly
   reception of echoes along the lower jaw. To evaluate how echolocation
   signals change while travelling through sponge tissue, we simulated
   echolocation using finite-element analysis based on digital models of
   sponge species (Echinodictyum mesenterinum and Ircinia spp.). We find
   that acoustic properties of the echolocation signal are changed in the
   presence of Ircinia spp. and, to a lesser extent, E. mesenterinum. Given
   distortions vary with each sponge, dolphins must adaptively and flexibly
   compensate during neural signal processing. This explains why sponging
   takes so long to learn, is strictly vertically transmitted and does not
   spread to others despite close association with tool users. Taken
   together, these findings provide a compelling look at the underlying
   intrinsic and extrinsic forces shaping tool use in wild populations.},
DOI = {10.1098/rsos.241900},
Article-Number = {241900},
ISSN = {2054-5703},
ResearcherID-Numbers = {Erbe, Christine/AAA-3801-2021
   Wei, Chong/E-2488-2019
   },
ORCID-Numbers = {Erbe, Christine/0000-0002-7884-9907
   Wei, Chong/0000-0002-2359-9285
   Mann, Janet/0000-0003-0664-175X},
Unique-ID = {WOS:001529445800001},
}

@article{ WOS:001523690600001,
Author = {Vajas, Pablo and Wudrick, Alannah and West, Hannah and Eddy, Tyler D.},
Title = {Increase in Harp Seal Ecosystem Role After the Cod Collapse in
   Newfoundland \& Labrador},
Journal = {FISH AND FISHERIES},
Year = {2025},
Volume = {26},
Number = {5},
Pages = {878-894},
Month = {SEP},
Abstract = {Pinniped populations have been increasing worldwide, posing challenges
   for fisheries management, including damage to fishing gear and
   competition for resources. In the Northwest Atlantic, harp seal numbers
   have increased from 1.8 million in 1970 to 6.5 million in 1990,
   stabilising at 4.4 million in 2024-one of the largest pinniped
   populations in the world. The large number of harp seals is associated
   with a high rate of prey consumption, raising questions about their
   impact on exploited and non-exploited species. In Newfoundland and
   Labrador, ecosystems were disrupted with collapses of cod and capelin in
   the 1990s, and these populations have not yet recovered. This study
   examines the harp seal ecological role and influence on ecosystem
   structure and function. Using Ecopath with Ecosim ecosystem models, we
   simulated various harp seal biomass scenarios for three key periods:
   pre-collapse (1985-1987), invertebrate dominance (2013-2015), and
   partial groundfish recovery (2018-2020). These scenarios explored harp
   seal depletion and recovery, impacts on cod stocks, and ecosystem
   effects. Simulations revealed that the ecosystem is driven by both
   top-down forces from harp seals and bottom-up forces from capelin, a key
   forage species. While moderate reductions in harp seal abundance had
   limited effects on cod, increasing capelin biomass had positive effects
   on both harp seals and cod. This study highlights the importance of
   integrating predator effects into ecosystem-based fisheries management
   to anticipate change and increase resilience in dynamic marine systems.},
