   Univ Trent, Dipartimento Fis, I-38050 Trento, Italy.
   Eotvos Lorand Univ, Inst Chem, Lab Interfaces \& Nanosize Syst, H-1117 Budapest, Hungary.},
DOI = {10.1016/j.molliq.2006.08.014},
ISSN = {0167-7322},
EISSN = {1873-3166},
Keywords = {dioleoylphosphatidylcholine; GMI; rafts; glycolipids},
Keywords-Plus = {UNSATURATED LIPID-BILAYERS; MONTE-CARLO-SIMULATION; FREE-ENERGY PROFILE;
