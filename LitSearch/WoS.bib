Language = {English},
Affiliation = {Brusa, JL (Corresponding Author), Univ Washington, Sch Environm \& Forest Sci, Anderson Hall,Box 352100, Seattle, WA 98195 USA.
   Brusa, Jamie L.; Rotella, Jay J., Montana State Univ, Dept Ecol, Bozeman, MT 59717 USA.
   Brusa, Jamie L., Univ Washington, Sch Environm \& Forest Sci, Anderson Hall,Box 352100, Seattle, WA 98195 USA.
   Banner, Katharine M., Montana State Univ, Dept Math Sci, Bozeman, MT 59717 USA.},
