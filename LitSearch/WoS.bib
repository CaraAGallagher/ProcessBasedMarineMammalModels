   Srinivasan, Mridula; Grant, William E.; Swannack, Todd M., Texas A\&M Univ, Dept Wildlife \& Fisheries Sci, Ecol Syst Lab, College Stn, TX 77843 USA.},
DOI = {10.1016/j.ecolmodel.2010.07.010},
