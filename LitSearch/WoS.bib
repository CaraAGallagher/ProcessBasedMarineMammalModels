@article{ WOS:000437115200007,
Author = {Devi, Sapna},
Title = {Effects of Awareness Programs to Save Dolphins: A Mathematical Model},
Journal = {INTERNATIONAL JOURNAL OF ECOLOGICAL ECONOMICS \& STATISTICS},
Year = {2018},
Volume = {39},
Number = {2},
Pages = {80-89},
Abstract = {This paper describes the dynamics of dolphin population in the presence
   of pollutants and harvesting both. Effects of awareness programs are
   studied on the proposed model. It is assumed that number of awareness
   programs increases with increase in concentration of pollutants and
   harvesting activity. For the analysis of the model, theory of
   differential equations is used and analytical results are accomplished
   by the numerical simulations. A condition under which the system
   persists uniformly is obtained. It is observed that, in the presence of
   awareness programs density of dolphin population can be maintained at
   desired level. It is also pointed out that awareness programs play a
   very crucial role in maintaining the equilibrium level of dolphin
   population when impacts of pollutants and harvesting activity on dolphin
   population increase.},
Publisher = {CENTRE ENVIRONMENT SOCIAL \& ECONOMIC RESEARCH PUBL-CESER},
Address = {PO BOX 113 ROORKEE, UTTARAKHAND, 247 667, INDIA},
Type = {Article},
Language = {English},
