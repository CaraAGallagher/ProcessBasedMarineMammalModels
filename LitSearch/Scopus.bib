doi={10.1111/j.1748-1716.1978.tb06213.x},
note={cited By 19},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-0018174151&doi=10.1111%2fj.1748-1716.1978.tb06213.x&partnerID=40&md5=e90b7edd5f53c63eaa389493c030b225},
affiliation={Department of Zoology, College of Biological Science, University of Guelph, Canada},
abstract={Temperature regulation in harp seal pups (Pagophilus groenlandicus) has been studied by in vivo measurements of oxygen consumption, body temperatures and in vitro determinations of the thermal values of a fur sample. The experimental animals were restrained and exposed to natural weather conditions. Solar irradiance above 600 W/m (global radiation) caused hyperthermia. Computer simulations based on the thermal values of the fur indicated that heat dissipation from primarily the limbs is a prerequisite for avoiding hyperthermia under natural weather conditions. Further simulations showed that the lower critical temperature of a lean newborn harp seal pup with standard metabolism is only – 1oC while it is depressed to –59oC as the pup grows, aquire a 10 cm thick layer of blubber and the metabolism increases to 1.5 times standard. High metabolism and tolerance to low deep body temperatures (35oC) seems a prerequisite for thermal balance in the harp seal pup under cold conditions. © 1978 Scandinavian Physiological Society},
author_keywords={body temperatures;  fur insulation;  Metabolism;  solar radiation;  thermal simulation model;  wind speed},
document_type={Article},
source={Scopus},
}

