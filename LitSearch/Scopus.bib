@ARTICLE{Cranford2014161,
author={Cranford, T.W. and Trijoulet, V. and Smith, C.R. and Krysl, P.},
title={Validation of a vibroacoustic finite element model using bottlenose dolphin simulations: The dolphin biosonar beam is focused in stages},
