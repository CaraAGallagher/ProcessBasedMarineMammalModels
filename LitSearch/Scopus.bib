@ARTICLE{Leaper2015375,
author={Leaper, R. and Calderan, S. and Cooke, J.},
title={A simulation framework to evaluate the efficiency of using visual observers to reduce the risk of injury from loud sound sources},
journal={Aquatic Mammals},
year={2015},
volume={41},
