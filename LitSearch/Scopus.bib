@ARTICLE{Klaich20112642,
author={Klaich, M.J. and Kinas, P.G. and Pedraza, S.N. and Coscarella, M.A. and Crespo, E.A.},
title={Estimating dyad association probability under imperfect and heterogeneous detection},
